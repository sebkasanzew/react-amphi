{
	"name": "react-amphi-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "bun run dev:web",
		"dev:web": "turbo dev --filter=@amphi/web --log-prefix=none",
		"dev:cli": "cd apps/cli && bun run dev",
		"test": "turbo test:e2e --filter=@amphi/web",
		"lint": "turbo lint && bun run lint:root",
		"lint:fix": "turbo lint -- --fix && bun run lint:fix:root",
		"lint:root": "bunx --bun eslint './{*.json,*.js,*.mjs,*.mts,*.ts}' --ext .json,.jsonc,.json5,.js,.ts,.mjs,.mts",
		"lint:fix:root": "bun run lint:root --fix",
		"typecheck": "turbo typecheck"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@typescript-eslint/parser": "8.71.2",
		"eslint": "10.12.0",
		"eslint-config-flat-gitignore": "2.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-playwright": "2.12.1",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-turbo": "2.11.7",
		"eslint-plugin-unicorn": "78.0.0",
		"prettier": "3.9.10",
		"turbo": "2.11.7",
		"@typescript/native": "npm:typescript@7.0.2",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.71.2",
		"vercel": "63.1.2"
	},
	"packageManager": "bun@1.4.3",
	"trustedDependencies": [
		"node-pty"
	]
}
